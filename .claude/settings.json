{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-write.mjs\"",
            "statusMessage": "하네스 저장 권한 확인"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-bash.mjs\"",
            "statusMessage": "하네스 셸 명령 확인"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-review.mjs\"",
            "statusMessage": "하네스 확인 대기 여부 확인"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-judge-read.mjs\"",
            "statusMessage": "judge 읽기 범위 확인"
          }
        ]
      },
      {
        "matcher": ".*(use_figma|generate_figma_design|upload_assets|create_new_file|generate_image|generate_diagram)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-judge-bash.mjs\"",
            "statusMessage": "judge Figma 코드 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*use_figma",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/record-judge-digest.mjs\"",
            "statusMessage": "judge 지문 기록"
          }
        ]
      }
    ]
  }
}

